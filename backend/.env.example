# Copier ce fichier en .env (jamais commité) et adapter les valeurs.

# Adresse du serveur OSRM (routes réelles). Sur Mac, le port 5000 est pris par AirPlay.
OSRM_URL=http://127.0.0.1:5001

# Temps que OR-Tools passe à améliorer la tournée. 500 ms suffit pour 40 arrêts ;
# à augmenter pour une très grosse journée (des centaines d'arrêts).
MILLISECONDES_OPTIMISATION=500
